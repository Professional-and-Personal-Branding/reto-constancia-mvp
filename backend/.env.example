# --- Database ---
# Local con docker-compose: postgresql://postgres:postgres@localhost:5433/reto_constancia
# Supabase prod: pega aquí la connection string de Supabase (modo Session para Render)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/reto_constancia?schema=public"

# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3005

# --- JWT ---
# Genera valores fuertes en prod: openssl rand -base64 64
JWT_SECRET=cambia_esto_en_prod_genera_64_bytes_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_tambien_otro_secret_distinto
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (para fotos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=reto-constancia

# --- Google Sheets (importación directa, opcional) ---
# Cuenta de servicio con la Sheets API habilitada; comparte la hoja (lector) con este email.
# La clave privada del JSON de la cuenta, en una sola línea con \n escapados (ver docs/import-template.md).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_DEFAULT_RANGE=actividades

# --- Admin inicial (seed) ---
SEED_ADMIN_EMAIL=admin@reto.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrador


